{
  "name": "@documentdrivendx/umf-visual",
  "version": "0.3.0",
  "private": true,
  "description": "UMF visual vocabulary and format interchange library",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/DocumentDrivenDX/umf-visual.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./spec/extensions/visual/1.0.0/schema.json",
    "./manifest": "./spec/extensions/visual/1.0.0/package.json",
    "./miro": {
      "types": "./dist/adapters/miro/index.d.ts",
      "import": "./dist/miro.js"
    },
    "./schema/1.1.0": "./spec/extensions/visual/schema.json",
    "./manifest/1.1.0": "./spec/extensions/visual/package.json",
    "./powerpoint": {
      "types": "./dist/adapters/powerpoint/index.d.ts",
      "import": "./dist/powerpoint.js"
    },
    "./google-slides": {
      "types": "./dist/adapters/google-slides/index.d.ts",
      "import": "./dist/google-slides.js"
    },
    "./miro/editable": {
      "types": "./dist/adapters/miro/editable/index.d.ts",
      "import": "./dist/miro-editable.js"
    },
    "./reconciliation": {
      "types": "./dist/adapters/reconciliation/index.d.ts",
      "import": "./dist/reconciliation.js"
    }
  },
  "files": [
    "dist",
    "spec",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "UPSTREAM.json"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "generate": "bun scripts/generate.ts",
    "check:source": "bun scripts/check-source.ts",
    "test:browser": "bun scripts/browser.ts",
    "test:package": "bun scripts/package-smoke.ts",
    "fetch:lini": "bun scripts/fetch-lini.ts",
    "test:native": "bun scripts/native-interchange.ts",
    "build:catalog": "bun scripts/catalog/build.ts",
    "build:site": "bun microsite/build.ts",
    "test:site": "bun scripts/catalog-ui-browser.ts",
    "test:catalog": "bun scripts/catalog/verify.ts",
    "report:loss": "bun scripts/catalog/loss-progress.ts",
    "report:loss:wave2": "bun scripts/catalog/loss-progress.ts --since-v0.1.0",
    "test:native:wave2": "bun scripts/native-wave-2.ts",
    "dev:miro": "bun scripts/miro-dev.ts",
    "test:native:annotated": "bun scripts/native-annotated.ts && bun scripts/native-lini-annotated.ts",
    "report:loss:ledger": "bun scripts/catalog/loss-ledger-report.ts",
    "test:release:catalog": "bun scripts/catalog/verify.ts --release",
    "test:site:profiles": "bun scripts/catalog-profile-ui-browser.ts",
    "test:native:layout": "bun scripts/native-lini-visual-layout.ts"
  },
  "dependencies": {
    "@umf/core": "https://github.com/DocumentDrivenDX/umf/releases/download/umf-v0.5.7/umf-sdk.tgz",
    "fflate": "0.8.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "playwright": "1.63.0",
    "typescript-api": "npm:typescript@5.9.3",
    "mermaid": "12.2.0"
  }
}
