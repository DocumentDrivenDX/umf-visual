{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "microsite/build.ts",
    "examples"
  ]
}
